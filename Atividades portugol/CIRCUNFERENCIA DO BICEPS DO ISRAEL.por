programa
{
	funcao inicio() {
	real raio,PI,Area
	
	PI= 3.14
	escreva("Qual  valor de raio de tal circuferência? \n")
	leia (raio) 
	Area= (PI*(raio*raio))
	escreva("A área desa circuferência é igual a: \n" , Area)
	
	}
}
