programa
{
	funcao inicio()
	{
		inteiro v1 
		escreva("Digite um valor: ")
		leia(v1)
		
		se (v1 >= 0){
			escreva("Esse valor é positivo.")
		}
		senao {
			escreva("Esse valor é negativo.")
		}
	}
}
