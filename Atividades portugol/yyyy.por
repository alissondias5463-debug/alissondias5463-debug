programa
{
	
	funcao inicio()
	{
		real BASE,ALTURA, AREA
		escreva(" _____ _____ _____ _____ \n")
		escreva("|  _  | __  |   __|  _  |\n")
		escreva("|     |    -|   __|     |\n")
		escreva("|__|__|__|__|_____|__|__|\n")
              
		escreva("Digite a altura do triângulo" ,"\n")
		leia (ALTURA)
		escreva("Digite o valor da base do triângulo","\n")
		leia (BASE)
		AREA=(BASE*ALTURA)/2
         escreva("A área desse triângulo é igual a ", AREA, "\n")
	}
}
