programa
{
	
	funcao inicio()
	{
	real v1
	escreva("digite um valor \n")
	leia (v1)
	se(v1>10){
		escreva("É maior do que 10!!!!!!!")
	}
	senao {
		escreva("É menor do que dez")
	}
	
	senao {
	escreva("É dez!!!")
	
	}
}
